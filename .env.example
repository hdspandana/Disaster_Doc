# DisasterDoc environment configuration
# Copy to .env and fill in as needed. NEVER commit real keys.

# Optional. Used only if AI commentary is explicitly enabled in the UI (off by default).
# Without it, the deterministic pipeline, statuses, evidence, and JSON/PDF reports still work.
GEMINI_API_KEY=

# Optional tuning
# DD_GEMINI_MODEL=gemini-2.5-flash
# DD_AI_TIMEOUT=25  # reserved; no Gemini SDK request timeout is currently applied
# DD_OCR_ENGINE=EasyOCR
# DD_MODEL_CACHE=~/.cache/easyocr
