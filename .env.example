# DisasterDoc environment configuration
# Copy to .env and fill in as needed. NEVER commit real keys.

# Optional. Enables the AI commentary layer (Gemini). Without it, DisasterDoc runs the
# full deterministic pipeline and reports "AI commentary unavailable" - everything else
# (statuses, evidence, JSON/PDF reports) works exactly the same.
GEMINI_API_KEY=

# Optional tuning
# DD_GEMINI_MODEL=gemini-2.5-flash
# DD_AI_TIMEOUT=25
# DD_OCR_ENGINE=EasyOCR
# DD_MODEL_CACHE=~/.cache/easyocr
